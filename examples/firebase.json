{
  "$schema": "../ship.config.schema.json",
  "_comment": "Firebase Hosting + Functions configuration",
  "build": {
    "command": "npm run build",
    "enabled": true
  },
  "deploy": {
    "command": "firebase deploy --only functions,hosting",
    "enabled": true
  },
  "verify": {
    "url": "https://your-app.web.app/",
    "enabled": true,
    "retries": 3,
    "retryDelay": 5
  },
  "environments": {
    "production": {
      "deploy": { "command": "firebase deploy --only functions,hosting" },
      "verify": { "url": "https://your-app.web.app/" },
      "protectedBranches": ["main"]
    },
    "staging": {
      "deploy": { "command": "firebase deploy --only functions,hosting --project your-app-staging" },
      "verify": { "url": "https://your-app-staging.web.app/" }
    }
  },
  "defaultEnvironment": "production"
}
