{
  "$schema": "../ship.config.schema.json",
  "_comment": "GitHub Pages deployment configuration (using gh-pages branch)",
  "build": {
    "command": "npm run build",
    "enabled": true
  },
  "deploy": {
    "command": "npx gh-pages -d dist",
    "enabled": true
  },
  "verify": {
    "url": "https://your-username.github.io/your-repo/",
    "enabled": true,
    "retries": 5,
    "retryDelay": 30
  },
  "git": {
    "addAll": true,
    "pushUpstream": true
  },
  "environments": {
    "production": {
      "deploy": { "command": "npx gh-pages -d dist" },
      "verify": { "url": "https://your-username.github.io/your-repo/" },
      "protectedBranches": ["main"]
    }
  },
  "defaultEnvironment": "production"
}
